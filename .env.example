# Spring 不自动读取此文件，设置到 shell 或 IDE 运行配置。
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/orderflow?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=orderflow
DB_PASSWORD=replace-with-your-database-password
JWT_SECRET=
DEV_SEED_PASSWORD=
CORS_ORIGINS=http://localhost:5173

# 可选：仅真实MySQL测试时设置，必须是独立且名称以_test结尾的库
ORDERFLOW_MYSQL_TEST_URL=jdbc:mysql://localhost:3306/orderflow_orders_test?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
ORDERFLOW_MYSQL_TEST_USERNAME=orderflow_test
ORDERFLOW_MYSQL_TEST_PASSWORD=replace-with-your-isolated-test-password

# 当前可用库存严格低于此值时显示预警
LOW_STOCK_THRESHOLD=10
